# ── 服务 ──────────────────────────────────────────────────────────────
# 本插件监听端口（兄弟插件占 19065 zcode / 19066 wukong / 19067 qwenwork / 19068 router）
KIMI_PORT=19069
# xrl-router 地址（WebSocket /ws/plugin）
XRL_ROUTER_URL=http://localhost:19068

# ── 密钥池（供 router 轮换） ─────────────────────────────────────────
# 逗号分隔的 sk-kimi-* 列表；用哪一把由 router 密钥池 round-robin 决定。
# login 脚本会写入；rotate 会自动替换。
KIMI_KEYS=

# ── 三层凭证链（插件自持，独立于 Kimi 客户端）─────────────────────────
# login 脚本写入。refresh 滚动时先写 KIMI_REFRESH_TOKEN 后写 KIMI_ACCESS_TOKEN（最不可逆先落盘）。
KIMI_ACCESS_TOKEN=
KIMI_REFRESH_TOKEN=
KIMI_USER_ID=
KIMI_KEY_ID=

# ── 模型清单 ─────────────────────────────────────────────────────────
# 逗号分隔，语法「模型ID=展示名」。留空则自动发现（GET agent-gw /models）。
# 客户端按展示名调 router → router 替换成模型 ID 转发给插件 → 插件透传上游。
KIMI_MODELS=

# ── 上游端点 ─────────────────────────────────────────────────────────
KIMI_GW_BASE=https://agent-gw.kimi.com/coding/v1
KIMI_APIV2_BASE=https://www.kimi.com/apiv2
KIMI_AUTH_BASE=https://auth.kimi.com/api

# ── 业务头（可选，最小头已验证足够）──────────────────────────────────
KIMI_USER_AGENT=Desktop Kimi Work
KIMI_MSH_VERSION=3.2.12

# ── 凭证刷新阈值 ─────────────────────────────────────────────────────
# access_token 剩余寿命低于此值即触发 refresh（单位毫秒；建议 90~120s 留网络余量）
KIMI_ACCESS_REFRESH_MARGIN_MS=120000
# sk-kimi rotate 去重冷却窗口（覆盖 pluginClient 5s 轮询 + router sync 延迟）
KIMI_ROTATE_DEDUP_COOLDOWN_MS=30000

# ── 429 engine_overloaded 退避重试 ───────────────────────────────────
KIMI_OVERLOAD_RETRY_BASE_MS=500
KIMI_OVERLOAD_MAX_RETRIES=3

# ── xrl-router WS 节奏 ───────────────────────────────────────────────
KIMI_HEARTBEAT_INTERVAL_MS=30000
KIMI_ENV_POLL_INTERVAL_MS=5000
KIMI_RECONNECT_BASE_MS=1000
KIMI_RECONNECT_MAX_MS=60000
